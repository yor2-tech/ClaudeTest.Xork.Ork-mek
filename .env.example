# Kopieren nach .env und Werte eintragen. Die .env-Datei NICHT ins Git hochladen.

# Zugang zu den Kameras (in der Kamera-Einstellung angelegter Benutzer)
FRIGATE_RTSP_USER=admin
FRIGATE_RTSP_PASSWORD=bitte-aendern

# MQTT (ein Benutzer für alles: Frigate, Wachhund, ESP32-Empfänger)
MQTT_USER=wachhund
MQTT_PASSWORD=bitte-aendern
FRIGATE_MQTT_USER=wachhund
FRIGATE_MQTT_PASSWORD=bitte-aendern

# Telefonnummer der Bot-SIM, über die Signal die Alarme verschickt
SIGNAL_BOT_NUMMER=+4915112345678
